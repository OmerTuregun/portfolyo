@{
    Layout = "_LayoutBento";
    ViewData["Title"] = "Projeler";
    ViewData["Description"] = "Ömer Faruk Türegün’ün okul, iş ve kişisel projeleri — fabrika sistemlerinden yapay zekâ ajanlarına.";
}

<div id="projects-page">
    <section class="projects-top" aria-label="Projeler özeti">
        <div class="tile tile--static projects-hero">
            <h1>Projeler</h1>
            <p class="lead">Okul, iş ve kişisel projeler. Fabrika sistemlerinden yapay zekâ ajanlarına kadar.</p>

            <div class="projects-toolbar">
                <div class="segment" id="projects-segment" role="group" aria-label="Kategori filtresi">
                    <button type="button" class="segment__btn" data-filter="all" aria-pressed="true">Tümü <span class="segment__count">0</span></button>
                    <button type="button" class="segment__btn" data-filter="web" aria-pressed="false">Web <span class="segment__count">0</span></button>
                    <button type="button" class="segment__btn" data-filter="ai" aria-pressed="false">Yapay zekâ <span class="segment__count">0</span></button>
                    <button type="button" class="segment__btn" data-filter="ind" aria-pressed="false">Endüstriyel <span class="segment__count">0</span></button>
                </div>

                <div class="projects-search form-field">
                    <label class="visually-hidden" for="projects-search">Proje ara</label>
                    <input id="projects-search" type="search" placeholder="Proje ya da teknoloji ara…" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="tile tile--accent tile--static projects-stat">
            <p class="eyebrow">Toplam</p>
            <p class="projects-stat__number" id="projects-total">—</p>
            <p class="projects-stat__meta" id="projects-total-meta">proje</p>
        </div>

        <div class="tile tile--dark tile--static projects-stack">
            <p class="eyebrow">Favori üçlü</p>
            <h2 class="projects-stack__title">Docker,<br>React, .NET</h2>
            <p>uçtan uca projelerin temeli</p>
        </div>
    </section>

    <p class="visually-hidden" id="projects-status" aria-live="polite">0 proje gösteriliyor</p>

    <section class="section" aria-label="Proje listesi">
        <div class="projects-grid" id="projects-grid">
            @for (var i = 0; i < 6; i++)
            {
                <div class="project-card-wrap">
                    <div class="project-card project-card--skeleton">
                        <span class="skeleton skeleton--block"></span>
                        <span class="skeleton skeleton--line skeleton--md"></span>
                        <span class="skeleton skeleton--line skeleton--lg"></span>
                        <span class="skeleton skeleton--line"></span>
                    </div>
                </div>
            }
        </div>
    </section>

    <dialog class="project-dialog" id="project-dialog" aria-labelledby="project-dialog-title">
        <button type="button" class="project-dialog__x" data-dialog-close aria-label="Kapat">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="project-dialog__inner" id="project-dialog-body"></div>
        <div class="project-dialog__actions">
            <a class="btn btn--primary" id="project-dialog-github" href="#" target="_blank" rel="noopener" hidden>GitHub'da incele ↗</a>
            <button type="button" class="btn btn--secondary" data-dialog-close>Kapat</button>
        </div>
    </dialog>
</div>

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded",function(){Bento.projects.init();});</script>
}
