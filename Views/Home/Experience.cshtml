@{
    Layout = "_LayoutBento";
    ViewData["Title"] = "Deneyim";
    ViewData["Description"] = "Ömer Faruk Türegün’ün iş deneyimi, stajlar, eğitim, sertifikalar ve referansları.";
    var lang = ViewContext.RouteData.Values["lang"]?.ToString()?.ToLower() ?? "tr";
    if (lang != "tr" && lang != "en") { lang = "tr"; }
}

<div id="experience-page">
    <section class="bento" aria-label="Deneyim özeti">
        <div class="tile tile--static span-2 exp-intro">
            <p class="eyebrow">Deneyim</p>
            <h1>Kariyer yolculuğu</h1>
            <p class="lead">İş deneyimi, stajlar, eğitim ve sürekli öğrenme — sahadan ürüne.</p>
            <div class="btn-row">
                <a class="btn btn--secondary" href="/files/CV_TR.pdf" download="OmerFarukTuregun_CV_TR.pdf">CV indir</a>
            </div>
        </div>

        <div class="tile tile--dark tile--static" id="exp-stats" aria-live="polite">
            <span class="skeleton skeleton--line skeleton--sm"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
        </div>

        <div class="tile tile--accent tile--static" id="exp-now" aria-live="polite">
            <span class="skeleton skeleton--line skeleton--sm skeleton--on-accent"></span>
            <span class="skeleton skeleton--line skeleton--lg skeleton--on-accent"></span>
            <span class="skeleton skeleton--line skeleton--on-accent"></span>
        </div>
    </section>

    <section class="section bento" id="exp-timeline" aria-label="Zaman çizelgesi">
        <div class="tile tile--static span-4">
            <span class="skeleton skeleton--line skeleton--md"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
            <span class="skeleton skeleton--line"></span>
        </div>
    </section>

    <section class="section bento" id="exp-edu-lang" aria-label="Eğitim ve diller">
        <div class="tile tile--static span-2">
            <span class="skeleton skeleton--line"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
        </div>
        <div class="tile tile--static">
            <span class="skeleton skeleton--line"></span>
            <span class="skeleton skeleton--line skeleton--md"></span>
        </div>
    </section>

    <section class="section" id="exp-certs-section" aria-labelledby="exp-certs-heading">
        <div class="section-head">
            <div class="section-head__text">
                <p class="eyebrow">Sertifikalar</p>
                <h2 id="exp-certs-heading">Öğrenmeye devam</h2>
            </div>
        </div>
        <div class="certs-grid" id="exp-certs">
            @for (var i = 0; i < 5; i++)
            {
                <div class="tile tile--static cert-card">
                    <span class="skeleton skeleton--line skeleton--sm"></span>
                    <span class="skeleton skeleton--line"></span>
                    <span class="skeleton skeleton--line skeleton--md"></span>
                </div>
            }
        </div>
    </section>

    <section class="section" id="exp-refs-section" aria-labelledby="exp-refs-heading">
        <div class="section-head">
            <div class="section-head__text">
                <p class="eyebrow">Referanslar</p>
                <h2 id="exp-refs-heading">Birlikte çalıştıklarım</h2>
            </div>
        </div>
        <div class="refs-grid" id="exp-refs">
            @for (var i = 0; i < 4; i++)
            {
                <div class="tile tile--static">
                    <span class="skeleton skeleton--line skeleton--lg"></span>
                    <span class="skeleton skeleton--line"></span>
                    <span class="skeleton skeleton--line skeleton--sm"></span>
                </div>
            }
        </div>
    </section>

    <dialog class="project-dialog" id="cert-dialog" aria-labelledby="cert-dialog-title">
        <button type="button" class="project-dialog__x" data-dialog-close aria-label="Kapat">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="project-dialog__inner" id="cert-dialog-body"></div>
        <div class="project-dialog__actions">
            <button type="button" class="btn btn--secondary" data-dialog-close>Kapat</button>
        </div>
    </dialog>
</div>

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded",function(){Bento.experience.init();});</script>
}
