@{
    Layout = null; // Kendi layout'umuzu kullanacağız
    ViewData["Title"] = "Deneyimlerim";
}

<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ömer Faruk Türegün</title>

    <!-- Favicon (Emoji) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>👨‍💻</text></svg>">

    <!-- Bootstrap & İkonlar -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Google Font (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">

    <!-- AOS (Animasyon) -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/3.5.0/css/flag-icon.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/6.6.6/css/flag-icon.min.css" />
    <!-- ANA CSS STİLLERİ -->
    <style>
        :root {
            --bg-dark: #0D1117;
            --bg-glass: rgba(30, 41, 59, 0.5); /* Yarı şeffaf cam */
            --border-glass: rgba(56, 68, 87, 0.5);
            --text-light: #E6EDF3;
            --text-muted: #8B949E;
            --primary-light: #90EE90; /* Fıstık Yeşili */
            --text-on-accent: #0D1117; /* Yeşilin üstündeki koyu yazı */
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.7;
        }

        /* Navbar */
        .navbar {
            background-color: var(--bg-glass) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--border-glass);
            border-radius: 1rem;
            margin: 1rem;
        }
            .navbar .nav-link {
                color: var(--text-muted);
                font-weight: 500;
                transition: all 0.2s ease-in-out;
            }
                .navbar .nav-link:hover,
                .navbar .nav-link.active {
                    color: var(--primary-light) !important;
                }
        .navbar-brand {
            font-weight: 700;
            color: var(--text-light);
        }

        /* Genel Başlık Stilleri */
        .display-5, .display-6 {
            color: var(--text-light);
        }

        /* Kart Stilleri */
        .glass-card {
            background: var(--bg-glass);
            border: 1px solid var(--border-glass);
            border-radius: 1rem;
            transition: all 0.3s ease;
        }

        #page-header {
            padding: 2rem 0;
        }

        /*
         * ==== DİKEY ZAMAN TÜNELİ (TIMELINE) STİLLERİ ====
         */
        .timeline-container {
            position: relative;
            padding: 2rem 0;
        }
            /* Ortadaki dikey çizgi */
            .timeline-container::before {
                content: '';
                position: absolute;
                top: 0;
                left: 1.5rem; /* İkonların merkezi */
                height: 100%;
                width: 3px;
                background-color: var(--border-glass);
                border-radius: 3px;
            }

        .timeline-group-header {
            margin-top: 1rem;
            margin-bottom: 1.5rem;
            position: relative; /* Çizginin üstünde kalsın */
        }
            .timeline-group-header h2 {
                background-color: var(--primary-light);
                color: var(--text-on-accent);
                font-weight: 700;
                font-size: 1.5rem;
                padding: 0.5rem 1rem;
                border-radius: 0.5rem;
                display: inline-block;
            }
        
        /* Her bir deneyim satırı */
        .timeline-item {
            position: relative;
            margin-bottom: 2rem;
            padding-left: 4rem; /* İkon + boşluk için yer aç */
        }

        /* Zaman tüneli ikonu (Çanta veya Okul) */
        .timeline-icon {
            position: absolute;
            left: 0;
            top: 0.1rem;
            width: 3rem;  /* Çizgi merkezi 1.5rem'deydi */
            height: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--bg-glass);
            border: 2px solid var(--border-glass);
            border-radius: 50%;
            z-index: 10;
        }
            .timeline-icon i {
                font-size: 1.25rem;
                color: var(--primary-light); /* Yeşil ikon */
            }

        /* Asıl içerik kartı */
        .timeline-card {
            background: var(--bg-glass);
            border: 1px solid var(--border-glass);
            border-radius: 1rem;
            padding: 1.5rem;
            transition: all 0.3s ease;
        }
            .timeline-card:hover {
                transform: translateY(-5px);
                border-color: rgba(144, 238, 144, 0.4);
            }

        .timeline-date {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--primary-light); /* Yeşil tarih */
            margin-bottom: 0.25rem;
        }
        .timeline-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-light);
            margin-bottom: 0.1rem;
        }
        .timeline-company {
            font-size: 1.1rem;
            color: var(--text-muted);
            font-weight: 500;
            margin-bottom: 0.75rem;
        }
        .timeline-description {
            color: var(--text-light);
            margin-bottom: 1rem;
        }
        
        /* Teknoloji Etiketleri (Tag'ler) */
        .timeline-tags {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
            .timeline-tags li {
                font-size: 0.85rem;
                font-weight: 500;
                background-color: rgba(144, 238, 144, 0.1);
                color: var(--primary-light);
                border: 1px solid rgba(144, 238, 144, 0.2);
                padding: 0.3rem 0.6rem;
                border-radius: 0.5rem;
            }

        /* Footer */
        .footer {
            border-top: 1px solid var(--border-glass);
            padding: 2rem 0;
            margin-top: 2rem;
            color: var(--text-muted);
        }

        .language-card {
            background: var(--bg-glass);
            border: 1px solid var(--border-glass);
            border-radius: 1rem;
            padding: 1.5rem;
            height: 100%;
        }
        .language-list {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
            display: flex;      /* Yan yana diz */
            flex-wrap: wrap;    /* SIĞMAZSA ALT SATIRA AT (ÇÖZÜM BU) */
            gap: 1rem;          /* Aralarına boşluk */
        }

        .language-list-item {
            flex-grow: 1;         /* Büyüyebildikleri kadar büyüsünler */
            flex-basis: 200px;    /* Ama en az 200px'lik yerleri olsun (Sığmazlarsa bu sayede alt alta geçerler) */
        }
            
        .language-list-item:last-child {
            margin-bottom: 0; 
        }

        .language-header {
            display: flex;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        /* Bayrak ikonu için düzeltilmiş stil */
        .language-flag {
            font-size: 1.25rem; /* Bayrak boyutu */
            margin-right: 0.75rem;
            border-radius: 50%;
            overflow: hidden;
            width: 20px; /* Sabit genişlik */
            height: 20px; /* Sabit yükseklik */
            line-height: 20px; /* Dikey hizalama */
        }
            .language-flag .flag-icon {
                width: 100%;
                height: 100%;
            }

        .language-info {
            flex-grow: 1;
        }
        .language-title {
            font-size: 1.1rem;
            color: var(--text-light);
            font-weight: 700;
        }
        .language-level {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-left: 0.5rem;
        }

        /* Progress Bar Stilleri */
        .language-progress-bar {
            width: 100%;
            height: 6px;
            background-color: var(--bg-glass); /* Bar'ın arka planı */
            border-radius: 3px;
            overflow: hidden;
        }
        .language-progress {
            height: 100%;
            background-color: var(--primary-light); /* Yeşil dolgu */
            width: 0%; /* Animasyon için başlangıç */
            transition: width 1s ease-out 0.3s; /* Gecikmeli animasyon */
        }

        /* DÜZELTME: Kart göründüğü anda animasyonu tetikle (AOS'a gerek yok) */
        .language-card .language-progress {
            width: var(--progress-width, 0%);
        }

        /* Sertifika Kartı Stilleri */
        .certificate-grid {
            display: grid;
            grid-template-columns: 1fr; /* Mobilde tek sütun */
            gap: 1rem;
        }

        /* Desktop'ta (LG) 2 sütunlu grid */
        @@media (min-width: 992px) {
            .certificate-grid {
                grid-template-columns: repeat(2, 1fr); /* 2 sütun */
                gap: 1.5rem;
            }
        }

        .certificate-card {
            background: var(--bg-glass);
            border: 1px solid var(--border-glass);
            border-radius: 1rem;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            height: 100%; /* Grid'de eşit yükseklik için */
        }

        .certificate-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-light);
            margin-bottom: 0.25rem;
        }
        .certificate-provider {
            font-size: 0.9rem;
            color: var(--primary-light); /* Yeşil */
            font-weight: 500;
        }
        .certificate-date {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
        }
        .certificate-skills {
            font-size: 0.9rem;
            color: var(--text-light);
            margin-top: auto;
            padding-top: 1rem;
        }
        .certificate-link {
            display: inline-block;
            margin-top: 1rem;
            font-weight: 700;
            color: var(--primary-light);
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .certificate-link:hover {
            color: #fff;
            transform: translateX(4px);
        }
    </style>
</head>
<body data-bs-theme="dark" class="bg-dark text-white">    
    <!-- ==== STICKY NAVBAR ==== -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Ömer Faruk TÜREGÜN
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="AboutMe">Hakkımda</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Projects">Projeler</a></li>
                    <li class="nav-item"><a class="nav-link active" aria-current="page" asp-controller="Home" asp-action="Experience">Deneyim</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">İletişim</a></li>
                </ul>
                <ul class="navbar-nav ms-2">
    <li class="nav-item">
        <!-- Bu 'Index' sayfasında olduğu için asp-action="Index" yazar -->
        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-lang="en" style="font-weight: 700;">
            <i class="bi bi-translate me-1"></i> EN
        </a>
    </li>
</ul>
            </div>
        </div>
    </nav>
    
    <!-- ==== ANA İÇERİK ==== -->
    <main class="container mt-4">
        
        <!-- Sayfa Başlığı -->
        <section id="page-header" class="mb-4">
            <div class="row g-4 align-items-stretch">
                
                <!-- Sol Sütun: Başlık -->
                <div class="col-lg-8" data-aos="fade-right">
                    <h1 class="display-5 fw-bold text-white mb-3">Deneyim & Eğitim</h1>
                    <p class="lead text-white-50">
                        Profesyonel kariyer yolculuğum ve akademik geçmişim.
                    </p>
                </div>
                
                <!-- Sağ Sütun: Diller Kartı Buraya JS ile Gelecek -->
                <div class="col-lg-4 d-flex align-items-stretch" id="language-card-container" data-aos="fade-left" data-aos-delay="100">
                    <!-- Diller kartı JS ile buraya yüklenecek -->
                </div>

            </div>
        </section>
        
        <!-- Zaman Tüneli (Timeline) -->
        <section class="timeline-container" id="experience-timeline-container">
            <!-- Deneyimler ve Eğitim buraya JS ile yüklenecek -->
        </section>

    </main>

    <!-- ==== SERTİFİKALAR BÖLÜMÜ ==== -->
    <section id="certificates-section" class="py-5">
        
        <div class="timeline-group-header" data-aos="fade-right" style="padding-left: 4rem;">
            <h2 id="certificates-title">Sertifikalar</h2> 
        </div>

        <!-- Sertifika Kartları Buraya JS ile Gelecek -->
        <div class="certificate-grid" id="certificates-container">
            <!-- Yükleniyor... (JS ile temizlenecek) -->
        </div>

    </section>

    <!-- ==== SERTİFİKA GÖRÜNTÜLEME MODALI (GİZLİ) ==== -->
    <div class="modal fade" id="certificateModal" tabindex="-1" aria-labelledby="certificateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl"> <!-- TAM EKRANA YAKIN (XL) -->
            <div class="modal-content" style="background-color: var(--bg-dark); border: 1px solid var(--border-glass);">
                
                <div class="modal-header border-0">
                    <!-- Başlık JS ile doldurulacak -->
                    <h5 class="modal-title text-white" id="certificateModalLabel">Sertifika</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body text-center p-2">
                    <!-- Resim JS ile buraya eklenecek -->
                    <img src="" id="certificateModalImage" class="img-fluid" alt="Sertifika Görüntüsü" style="max-height: 80vh;">
                </div>

            </div>
        </div>
    </div>
    
    <!-- ==== FOOTER ==== -->
    <footer class="footer">
        <div class="container text-center">
            <span class="text-muted">© @DateTime.Now.Year Ömer Faruk Türegün. Tüm hakları saklıdır.</span>
        </div>
    </footer>
    
    <!-- Bootstrap & AOS Scriptleri -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <!-- ANA SCRIPT (JSON'dan Veri Çekme) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Animasyonları başlat
            AOS.init({
                duration: 600,
                once: true
            });
            
            // Veriyi çek ve HTML'i oluştur
            fetchExperienceData();
            fetchCertificates();

            const certificateModal = document.getElementById('certificateModal');
            if (certificateModal) {
                certificateModal.addEventListener('show.bs.modal', function (event) {
                    // Tıklanan link (buton)
                    const button = event.relatedTarget;
                    
                    // Veriyi linkin data-* özelliklerinden çek
                    const imgSrc = button.getAttribute('data-img-src');
                    const title = button.getAttribute('data-title');

                    // Modal'ın içindeki elemanları bul ve güncelle
                    const modalTitle = certificateModal.querySelector('#certificateModalLabel');
                    const modalImage = certificateModal.querySelector('#certificateModalImage');
                    
                    modalTitle.textContent = title;
                    modalImage.src = imgSrc;
                });
            }
        });

        // ==== ESKİ "fetchExperienceData" FONKSİYONUNU SİLİP BUNU EKLE ====

        async function fetchExperienceData() {
            try {
                // Cache'i bypass etmek için timestamp ekle
                const timestamp = new Date().getTime();
                const response = await fetch(`/data/experience.json?v=${timestamp}`);
                if (!response.ok) throw new Error('Veri alınamadı');
                
                const data = await response.json();
                const timelineContainer = document.getElementById('experience-timeline-container');
                const languageContainer = document.getElementById('language-card-container');
                
                timelineContainer.innerHTML = ''; // Zaman tünelini temizle
                languageContainer.innerHTML = ''; // Diller kartını temizle

                // JSON'daki her bir grubu (Eğitim, İş, Staj, Diller) işle
                // Not: Admin tarafında yeni kayıtlar listenin en başına ekleniyor,
                // bu yüzden burada ayrıca ID'ye göre sıralama yapmıyoruz.
                data.forEach(group => {
                    
                    // ---- YENİ LOGIC BURADA ----
                    // Eğer grup "Diller" ise, onu SAĞ ÜST SÜTUNA (languageContainer) at
                    if (group.type === 'Diller') {
                        const items = group.items;
                        languageContainer.innerHTML = createLanguageCardHTML(items);
                    } 
                    // Değilse (Eğitim, İş, Staj), onu ANA ZAMAN TÜNELİNE (timelineContainer) at
                    else {
                        // Grup Başlığı (örn: "İş Deneyimi")
                        timelineContainer.innerHTML += `
                            <div class="timeline-group-header" data-aos="fade-right">
                                <h2>${group.type}</h2>
                            </div>
                        `;
                        
                        // Grup içindeki item'ları işle
                        const items = group.experience || group.items;
                        items.forEach((item, index) => {
                            const iconClass = group.type === 'Eğitim' ? 'bi-mortarboard-fill' : 'bi-briefcase-fill';
                            timelineContainer.innerHTML += createTimelineItemHTML(item, iconClass, index);
                        });
                    }
                    // ---- /YENİ LOGIC BİTTİ ----
                });

                setTimeout(() => { AOS.refresh(); }, 100);

            } catch (error) {
                console.error('Deneyim verisi yüklenirken hata:', error);
                document.getElementById('experience-timeline-container').innerHTML = '<p class="text-danger text-center">Deneyimler yüklenirken bir hata oluştu.</p>';
            }
        }

        function createLanguageCardHTML(items) {
            
            const listItemsHTML = items.map(item => `
                <li class="language-list-item">
                    <div class="language-header">
                        <!-- Bayrak (DÜZELTİLMİŞ HTML) -->
                        <span class="language-flag">
                            <span class="flag-icon flag-icon-${item.flagCode}"></span>
                        </span>
                        <!-- Başlık ve Seviye -->
                        <div class="language-info">
                            <span class="language-title">${item.title}</span>
                            <span class="language-level">${item.description}</span>
                        </div>
                    </div>
                    <!-- Progress Bar -->
                    <div class="language-progress-bar">
                        <div class="language-progress" style="--progress-width: ${item.percentage}%;"></div>
                    </div>
                </li>
            `).join('');

            return `
            <div class="language-card">
                <h5 class="text-white fw-bold mb-3">Diller</h5>
                <ul class="language-list">
                    ${listItemsHTML}
                </ul>
            </div>
            `;
        }

        // 2. Zaman Tüneli Kartını oluşturan fonksiyon (DEĞİŞMEDİ)
        function createTimelineItemHTML(item, iconClass, index) {
            let tagsHTML = '';
            if (item.tags && item.tags.length > 0) {
                tagsHTML = `
                    <ul class="timeline-tags">
                        ${item.tags.map(tag => `<li>${tag}</li>`).join('')}
                    </ul>
                `;
            }
            return `
            <div class="timeline-item" data-aos="fade-up" data-aos-delay="${index * 100}">
                <div class="timeline-icon">
                    <i class="bi ${iconClass}"></i>
                </div>
                <div class="timeline-card">
                    <div class="timeline-date">${item.dateRange}</div>
                    <h4 class="timeline-title">${item.title}</h4>
                    <h5 class="timeline-company">${item.company}</h5>
                    <p class="timeline-description">${item.description}</p>
                    ${tagsHTML}
                </div>
            </div>
            `;
        }

        async function fetchCertificates() {
            // Dil (lang) parametresine göre doğru JSON'u seç
            const lang = document.documentElement.lang || 'tr';
            const jsonPath = lang === 'en' ? '/data-en/certificates.json' : '/data/certificates.json';
            
            // TR veya EN başlık
            const titleText = lang === 'en' ? 'Certificates' : 'Sertifikalar';
            document.getElementById('certificates-title').innerText = titleText;
            
            try {
                // Cache'i bypass etmek için timestamp ekle
                const timestamp = new Date().getTime();
                const response = await fetch(`${jsonPath}?v=${timestamp}`);
                if (!response.ok) throw new Error('Sertifika verisi alınamadı');
                
                const data = await response.json();
                const container = document.getElementById('certificates-container');
                container.innerHTML = ''; // Temizle

                data.forEach((cert, index) => {
                    container.innerHTML += createCertificateCardHTML(cert, index, lang);
                });

                AOS.refresh();

            } catch (error) {
                console.error('Sertifikalar yüklenirken hata oluştu:', error);
                container.innerHTML = '<p class="text-danger text-center">Sertifikalar yüklenirken bir hata oluştu.</p>';
            }
        }

        function createCertificateCardHTML(cert, index, lang) {
            const linkText = lang === 'en' ? 'View Certificate' : 'Sertifikayı Görüntüle';
            const skillsTitle = lang === 'en' ? 'Skills' : 'Yetenekler';
            
            // Resim yolunu düzelt
            let correctedImgUrl = cert.imageUrl.startsWith('~/') ? cert.imageUrl.substring(1) : cert.imageUrl;

            return `
            <div class="certificate-card" data-aos="fade-up" data-aos-delay="${(index % 2) * 100}">
                <div class="certificate-provider">${cert.provider}</div>
                <h4 class="certificate-title">${cert.title}</h4>
                <div class="certificate-date">${cert.date}</div>
                
                <p class="certificate-skills mb-0">
                    <strong>${skillsTitle}:</strong> ${cert.skills.join(' · ')}
                </p>

                <!-- 
                    DEĞİŞİKLİK BURADA:
                    Bu artık bir 'a' linki değil, modal'ı açan bir 'button' linki.
                    'data-bs-toggle' ve 'data-bs-target' eklendi.
                    'data-img-src' ve 'data-title' ile modalı besleyeceğiz.
                -->
                <a href="#" class="certificate-link"
                data-bs-toggle="modal"
                data-bs-target="#certificateModal"
                data-img-src="${correctedImgUrl}"
                data-title="${cert.title}">
                    ${linkText} <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
            `;
        }

    </script>
    
</body>
</html>