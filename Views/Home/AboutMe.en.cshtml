@{
    Layout = "_LayoutBento";
    ViewData["Title"] = "About";
    ViewData["Description"] = "About Ömer Faruk Türegün — software, AI, field work, and community.";
    var lang = ViewContext.RouteData.Values["lang"]?.ToString()?.ToLower() ?? "en";
    if (lang != "tr" && lang != "en") { lang = "en"; }
}

<div id="about-page">
    <section class="bento about-hero" aria-label="About">
        <div class="tile tile--static about-photo row-2">
            <img src="~/img/profil.jpg"
                 asp-append-version="true"
                 alt="Ömer Faruk Türegün"
                 width="640"
                 height="800"
                 class="about-photo__img"
                 loading="eager"
                 fetchpriority="high"
                 decoding="async" />
        </div>

        <div class="tile tile--static span-2 row-2 about-intro">
            <p class="eyebrow">About</p>
            <h1 class="about-intro__title">I work on every step, from the first idea to production.</h1>
            <div id="about-intro-copy" class="about-intro__copy" aria-live="polite">
                <span class="skeleton skeleton--line skeleton--lg"></span>
                <span class="skeleton skeleton--line"></span>
                <span class="skeleton skeleton--line skeleton--md"></span>
            </div>
            <div class="btn-row about-intro__actions">
                <a class="btn btn--primary" href="/files/CV_EN.pdf" target="_blank" rel="noopener">Download CV</a>
                <a class="btn btn--secondary" asp-controller="Home" asp-action="Experience" asp-route-lang="@lang">See my experience →</a>
            </div>
        </div>

        <div class="tile tile--accent tile--static" id="about-goal" aria-live="polite">
            <span class="skeleton skeleton--line skeleton--sm skeleton--on-accent"></span>
            <span class="skeleton skeleton--line skeleton--lg skeleton--on-accent"></span>
            <span class="skeleton skeleton--line skeleton--on-accent"></span>
        </div>

        <div class="tile tile--dark tile--static" id="about-stats" aria-live="polite">
            <span class="skeleton skeleton--line skeleton--sm"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
        </div>
    </section>

    <section class="section" id="about-beyond-section" aria-labelledby="about-beyond-heading">
        <div class="section-head">
            <div class="section-head__text">
                <p class="eyebrow">Beyond code</p>
                <h2 id="about-beyond-heading">Field, team, community</h2>
            </div>
        </div>
        <div class="bento about-beyond" id="about-beyond">
            <div class="tile tile--static span-2 about-activity about-activity--skeleton"></div>
            <div class="tile tile--static about-activity about-activity--skeleton"></div>
            <div class="tile tile--static about-freetime">
                <span class="skeleton skeleton--line skeleton--md"></span>
                <span class="skeleton skeleton--line"></span>
            </div>
        </div>
    </section>

    <dialog class="project-dialog" id="about-goal-dialog" aria-labelledby="about-goal-dialog-title">
        <button type="button" class="project-dialog__x" data-dialog-close aria-label="Close">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="project-dialog__inner" id="about-goal-dialog-body"></div>
        <div class="project-dialog__actions">
            <button type="button" class="btn btn--secondary" data-dialog-close>Close</button>
        </div>
    </dialog>

    <dialog class="project-dialog gallery-dialog" id="about-gallery-dialog" aria-label="Gallery">
        <button type="button" class="project-dialog__x" data-dialog-close aria-label="Close">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="gallery-dialog__layout">
            <div class="gallery-dialog__visual">
                <div class="gallery-dialog__stage">
                    <img id="about-gallery-main" alt="" width="1200" height="800" />
                </div>
                <div class="gallery-dialog__controls">
                    <button type="button" class="btn btn--secondary" id="about-gallery-prev" aria-label="Previous photo">‹ Previous</button>
                    <span class="gallery-dialog__counter" id="about-gallery-counter">1 / 1</span>
                    <button type="button" class="btn btn--secondary" id="about-gallery-next" aria-label="Next photo">Next ›</button>
                </div>
                <div class="gallery-dialog__thumbs" id="about-gallery-thumbs"></div>
            </div>
            <div class="gallery-dialog__copy" id="about-gallery-copy"></div>
        </div>
    </dialog>
</div>

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded",function(){Bento.about.init();});</script>
}
