@{
    Layout = "_LayoutBento";
    ViewData["Title"] = "Projects";
    ViewData["Description"] = "School, work, and personal projects by Ömer Faruk Türegün — from factory systems to AI agents.";
}

<div id="projects-page">
    <section class="projects-top" aria-label="Projects overview">
        <div class="tile tile--static projects-hero">
            <h1>Projects</h1>
            <p class="lead">School, work, and personal projects. From factory systems to AI agents.</p>

            <div class="projects-toolbar">
                <div class="segment" id="projects-segment" role="group" aria-label="Category filter">
                    <button type="button" class="segment__btn" data-filter="all" aria-pressed="true">All <span class="segment__count">0</span></button>
                    <button type="button" class="segment__btn" data-filter="web" aria-pressed="false">Web <span class="segment__count">0</span></button>
                    <button type="button" class="segment__btn" data-filter="ai" aria-pressed="false">AI <span class="segment__count">0</span></button>
                    <button type="button" class="segment__btn" data-filter="ind" aria-pressed="false">Industrial <span class="segment__count">0</span></button>
                </div>

                <div class="projects-search form-field">
                    <label class="visually-hidden" for="projects-search">Search projects</label>
                    <input id="projects-search" type="search" placeholder="Search project or technology…" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="tile tile--accent tile--static projects-stat">
            <p class="eyebrow">Total</p>
            <p class="projects-stat__number" id="projects-total">—</p>
            <p class="projects-stat__meta" id="projects-total-meta">projects</p>
        </div>

        <div class="tile tile--dark tile--static projects-stack">
            <p class="eyebrow">Go-to stack</p>
            <h2 class="projects-stack__title">Docker,<br>React, .NET</h2>
            <p>the backbone of my end-to-end work</p>
        </div>
    </section>

    <p class="visually-hidden" id="projects-status" aria-live="polite">0 projects showing</p>

    <section class="section" aria-label="Project list">
        <div class="projects-grid" id="projects-grid">
            @for (var i = 0; i < 6; i++)
            {
                <div class="project-card-wrap">
                    <div class="project-card project-card--skeleton">
                        <span class="skeleton skeleton--block"></span>
                        <span class="skeleton skeleton--line skeleton--md"></span>
                        <span class="skeleton skeleton--line skeleton--lg"></span>
                        <span class="skeleton skeleton--line"></span>
                    </div>
                </div>
            }
        </div>
    </section>

    <dialog class="project-dialog" id="project-dialog" aria-labelledby="project-dialog-title">
        <button type="button" class="project-dialog__x" data-dialog-close aria-label="Close">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="project-dialog__inner" id="project-dialog-body"></div>
        <div class="project-dialog__actions">
            <a class="btn btn--primary" id="project-dialog-github" href="#" target="_blank" rel="noopener" hidden>View on GitHub ↗</a>
            <button type="button" class="btn btn--secondary" data-dialog-close>Close</button>
        </div>
    </dialog>
</div>

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded",function(){Bento.projects.init();});</script>
}
