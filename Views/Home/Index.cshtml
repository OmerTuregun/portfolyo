@{
    Layout = "_LayoutBento";
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Description"] = "Ömer Faruk Türegün — yazılım geliştirici. ASP.NET Core, Node.js, React ve yapay zekâ ile ürün geliştiriyorum.";
    var lang = ViewContext.RouteData.Values["lang"]?.ToString()?.ToLower() ?? "tr";
    if (lang != "tr" && lang != "en") { lang = "tr"; }
}

<section class="bento home-hero" aria-label="Tanıtım">
    <div class="tile span-2 row-2 home-intro">
        <div class="home-intro__top">
            <img class="home-avatar" src="~/img/profil.jpg" asp-append-version="true" width="72" height="72" alt="Ömer Faruk Türegün" loading="eager" fetchpriority="high" decoding="async" />
            <span class="badge-status">
                <span class="badge-status__dot" aria-hidden="true"></span>
                Yeni projelere açık
            </span>
        </div>
        <h1 class="display">Selam, ben<br>Ömer Faruk.</h1>
        <p class="lead">Yazılım geliştiriciyim. <strong>ASP.NET Core, Node.js ve React</strong> ile ürün geliştiriyor, yapay zekâyı gerçek işlere bağlıyorum.</p>
        <div class="btn-row">
            <a class="btn btn--primary" asp-controller="Home" asp-action="Contact" asp-route-lang="@lang" asp-route-konu="is">Benimle çalış →</a>
            <a class="btn btn--secondary" href="/files/CV_TR.pdf" target="_blank" rel="noopener">CV indir</a>
        </div>
    </div>

    <div class="tile tile--dark" id="home-now" aria-live="polite">
        <span class="skeleton skeleton--line skeleton--sm"></span>
        <span class="skeleton skeleton--line skeleton--lg"></span>
        <span class="skeleton skeleton--line"></span>
        <span class="skeleton skeleton--line skeleton--md"></span>
    </div>

    <partial name="_BentoLocationTile" />

    <a class="tile tile--accent span-2" id="home-featured" href="#" aria-live="polite">
        <span class="skeleton skeleton--line skeleton--sm skeleton--on-accent"></span>
        <span class="skeleton skeleton--line skeleton--lg skeleton--on-accent"></span>
        <span class="skeleton skeleton--line skeleton--on-accent"></span>
        <span class="skeleton skeleton--line skeleton--md skeleton--on-accent"></span>
    </a>

    <div class="tile span-2 home-github tile--static" id="home-github">
        <div class="home-github__head">
            <div>
                <p class="eyebrow">Katkılar</p>
                <h3>GitHub katkıları</h3>
            </div>
            <div class="home-github__aside">
                <p class="home-github__meta" data-github-meta></p>
                <a class="home-github__link" href="https://github.com/OmerTuregun" target="_blank" rel="noopener">@@OmerTuregun ↗</a>
            </div>
        </div>
        <p class="visually-hidden" data-github-summary></p>
        <div class="heatmap" aria-hidden="true" data-github-heatmap>
            @for (var i = 0; i < 210; i++)
            {
                <span class="heatmap__cell" data-level="0"></span>
            }
        </div>
    </div>

    <div class="tile home-stack tile--static">
        <p class="eyebrow">Stack</p>
        <h3>Araçlar</h3>
        <div class="chip-row">
            <span class="chip">C#</span>
            <span class="chip">.NET</span>
            <span class="chip">Node.js</span>
            <span class="chip">React</span>
            <span class="chip">TypeScript</span>
            <span class="chip">Python</span>
            <span class="chip">PostgreSQL</span>
            <span class="chip">Docker</span>
            <span class="chip">Nginx</span>
        </div>
    </div>

    <div class="tile home-links tile--static">
        <p class="eyebrow">Bağlantılar</p>
        <h3>Linkler</h3>
        <ul class="link-list">
            <li><a href="https://www.linkedin.com/in/%C3%B6mer-faruk-t%C3%BCreg%C3%BCn-6360532b6/" target="_blank" rel="noopener">LinkedIn ↗</a></li>
            <li><a href="https://github.com/OmerTuregun" target="_blank" rel="noopener">GitHub ↗</a></li>
            <li><a href="https://medium.com/@@trkuraf" target="_blank" rel="noopener">Medium ↗</a></li>
            <li><a href="mailto:trkuraf@gmail.com">E-posta ↗</a></li>
        </ul>
    </div>
</section>

<section class="section" aria-labelledby="home-selected-heading">
    <div class="section-head">
        <div class="section-head__text">
            <p class="eyebrow">Seçili işler</p>
            <h2 id="home-selected-heading">Son projelerim</h2>
        </div>
        <a class="section-head__link" id="home-all-projects" asp-controller="Home" asp-action="Projects" asp-route-lang="@lang">projelerin tümü →</a>
    </div>
    <div class="bento" id="home-selected" aria-live="polite">
        <div class="tile span-2 row-2 tile--static">
            <span class="skeleton skeleton--block"></span>
            <span class="skeleton skeleton--line skeleton--md"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
            <span class="skeleton skeleton--line"></span>
        </div>
        <div class="tile tile--static"><span class="skeleton skeleton--box"></span><span class="skeleton skeleton--line"></span><span class="skeleton skeleton--line skeleton--md"></span></div>
        <div class="tile tile--static"><span class="skeleton skeleton--box"></span><span class="skeleton skeleton--line"></span><span class="skeleton skeleton--line skeleton--md"></span></div>
        <div class="tile tile--static"><span class="skeleton skeleton--box"></span><span class="skeleton skeleton--line"></span><span class="skeleton skeleton--line skeleton--md"></span></div>
        <div class="tile tile--static"><span class="skeleton skeleton--box"></span><span class="skeleton skeleton--line"></span><span class="skeleton skeleton--line skeleton--md"></span></div>
    </div>
</section>

<section class="section" aria-labelledby="home-journey-heading">
    <p class="eyebrow">Deneyim</p>
    <h2 id="home-journey-heading">Yolculuk</h2>
    <div class="bento bento--journey" id="home-journey" aria-live="polite">
        <div class="tile tile--static"><span class="skeleton skeleton--line skeleton--sm"></span><span class="skeleton skeleton--line skeleton--lg"></span><span class="skeleton skeleton--line"></span></div>
        <div class="tile tile--static"><span class="skeleton skeleton--line skeleton--sm"></span><span class="skeleton skeleton--line skeleton--lg"></span><span class="skeleton skeleton--line"></span></div>
        <div class="tile tile--static"><span class="skeleton skeleton--line skeleton--sm"></span><span class="skeleton skeleton--line skeleton--lg"></span><span class="skeleton skeleton--line"></span></div>
        <div class="tile tile--static"><span class="skeleton skeleton--line skeleton--sm"></span><span class="skeleton skeleton--line skeleton--lg"></span><span class="skeleton skeleton--line"></span></div>
    </div>
</section>

<section class="section">
    <div class="tile tile--dark tile--static home-cta">
        <div class="home-cta__text">
            <p class="eyebrow">İletişim</p>
            <h2>Bir fikrin mi var?<br>Birlikte inşa edelim.</h2>
        </div>
        <a class="btn btn--accent" asp-controller="Home" asp-action="Contact" asp-route-lang="@lang" asp-route-konu="proje">Mesaj gönder →</a>
    </div>
</section>

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded",function(){Bento.home.init();});</script>
}
