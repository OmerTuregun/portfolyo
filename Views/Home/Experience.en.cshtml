@{
    Layout = "_LayoutBento";
    ViewData["Title"] = "Experience";
    ViewData["Description"] = "Ömer Faruk Türegün’s work experience, internships, education, certificates, and references.";
    var lang = ViewContext.RouteData.Values["lang"]?.ToString()?.ToLower() ?? "en";
    if (lang != "tr" && lang != "en") { lang = "en"; }
}

<div id="experience-page">
    <section class="bento" aria-label="Experience overview">
        <div class="tile tile--static span-2 exp-intro">
            <p class="eyebrow">Experience</p>
            <h1>Career journey</h1>
            <p class="lead">Work experience, internships, education, and continuous learning — from the floor to the product.</p>
            <div class="btn-row">
                <a class="btn btn--secondary" href="/files/CV_EN.pdf" target="_blank" rel="noopener">Download CV</a>
            </div>
        </div>

        <div class="tile tile--dark tile--static" id="exp-stats" aria-live="polite">
            <span class="skeleton skeleton--line skeleton--sm"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
        </div>

        <div class="tile tile--accent tile--static" id="exp-now" aria-live="polite">
            <span class="skeleton skeleton--line skeleton--sm skeleton--on-accent"></span>
            <span class="skeleton skeleton--line skeleton--lg skeleton--on-accent"></span>
            <span class="skeleton skeleton--line skeleton--on-accent"></span>
        </div>
    </section>

    <section class="section bento" id="exp-timeline" aria-label="Timeline">
        <div class="tile tile--static span-4">
            <span class="skeleton skeleton--line skeleton--md"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
            <span class="skeleton skeleton--line"></span>
        </div>
    </section>

    <section class="section bento" id="exp-edu-lang" aria-label="Education and languages">
        <div class="tile tile--static span-2">
            <span class="skeleton skeleton--line"></span>
            <span class="skeleton skeleton--line skeleton--lg"></span>
        </div>
        <div class="tile tile--static">
            <span class="skeleton skeleton--line"></span>
            <span class="skeleton skeleton--line skeleton--md"></span>
        </div>
    </section>

    <section class="section" id="exp-certs-section" aria-labelledby="exp-certs-heading">
        <div class="section-head">
            <div class="section-head__text">
                <p class="eyebrow">Certificates</p>
                <h2 id="exp-certs-heading">Always learning</h2>
            </div>
        </div>
        <div class="certs-grid" id="exp-certs">
            @for (var i = 0; i < 5; i++)
            {
                <div class="tile tile--static cert-card">
                    <span class="skeleton skeleton--line skeleton--sm"></span>
                    <span class="skeleton skeleton--line"></span>
                    <span class="skeleton skeleton--line skeleton--md"></span>
                </div>
            }
        </div>
    </section>

    <section class="section" id="exp-refs-section" aria-labelledby="exp-refs-heading">
        <div class="section-head">
            <div class="section-head__text">
                <p class="eyebrow">References</p>
                <h2 id="exp-refs-heading">People I've worked with</h2>
            </div>
        </div>
        <div class="refs-grid" id="exp-refs">
            @for (var i = 0; i < 4; i++)
            {
                <div class="tile tile--static">
                    <span class="skeleton skeleton--line skeleton--lg"></span>
                    <span class="skeleton skeleton--line"></span>
                    <span class="skeleton skeleton--line skeleton--sm"></span>
                </div>
            }
        </div>
    </section>

    <dialog class="project-dialog" id="cert-dialog" aria-labelledby="cert-dialog-title">
        <button type="button" class="project-dialog__x" data-dialog-close aria-label="Close">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="project-dialog__inner" id="cert-dialog-body"></div>
        <div class="project-dialog__actions">
            <button type="button" class="btn btn--secondary" data-dialog-close>Close</button>
        </div>
    </dialog>
</div>

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded",function(){Bento.experience.init();});</script>
}
