@{
    Layout = "_LayoutBento";
    ViewData["Title"] = "İletişim";
    ViewData["Description"] = "Ömer Faruk Türegün ile iletişime geçin — iş teklifi, proje veya merhaba.";
    var lang = ViewContext.RouteData.Values["lang"]?.ToString()?.ToLower() ?? "tr";
    if (lang != "tr" && lang != "en") { lang = "tr"; }
}

<section class="bento contact-bento" id="contact-page" aria-label="İletişim">
    <div class="tile tile--static span-2 row-3 contact-form-tile contact-order-form" id="contact-form-panel" aria-live="polite">
        <p class="eyebrow">İletişim</p>
        <h1 class="contact-title">Hadi konuşalım.</h1>

        <form id="contact-form"
              action="https://formspree.io/f/xvgvvblj"
              method="POST"
              novalidate>
            <div class="contact-topics" role="group" aria-label="Konu">
                <button type="button" class="contact-topic" data-topic="İş teklifi" data-topic-key="is" aria-pressed="true">İş teklifi</button>
                <button type="button" class="contact-topic" data-topic="Serbest proje" data-topic-key="proje" aria-pressed="false">Serbest proje</button>
                <button type="button" class="contact-topic" data-topic="Sadece merhaba" data-topic-key="merhaba" aria-pressed="false">Sadece merhaba</button>
            </div>

            <input type="hidden" name="konu" id="contact-konu" value="İş teklifi" />
            <input type="hidden" name="_subject" id="contact-subject" value="Portfolyo · İş teklifi" />
            <input type="text" name="_gotcha" id="contact-gotcha" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="contact-fields">
                <div class="form-field">
                    <label for="contact-name">Ad Soyad</label>
                    <input id="contact-name" name="AdSoyad" type="text" autocomplete="name" placeholder="Adınız Soyadınız" />
                    <p class="form-error" id="contact-name-error" hidden></p>
                </div>
                <div class="form-field">
                    <label for="contact-email">E-posta</label>
                    <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="ornek@mail.com" />
                    <p class="form-error" id="contact-email-error" hidden></p>
                </div>
            </div>

            <div class="form-field">
                <label for="contact-message">Mesaj</label>
                <textarea id="contact-message" name="mesaj" rows="6" placeholder="Kısaca anlatın…"></textarea>
                <p class="form-error" id="contact-message-error" hidden></p>
            </div>

            <p class="form-error form-error--form" id="contact-form-error" hidden></p>

            <button type="submit" class="btn btn--primary" id="contact-submit">Gönder →</button>
        </form>
    </div>

    <div class="tile tile--dark tile--static span-2 contact-email-tile contact-order-email">
        <p class="eyebrow">Doğrudan e-posta</p>
        <p class="contact-email-address" id="contact-email-display">trkuraf@gmail.com</p>
        <div class="btn-row">
            <button type="button" class="btn btn--accent" id="contact-copy" data-email="trkuraf@gmail.com">Adresi kopyala</button>
            <a class="btn btn--on-dark" href="mailto:trkuraf@gmail.com">Mail uygulamasında aç ↗</a>
        </div>
    </div>

    <div class="contact-order-location">
        <partial name="_BentoLocationTile" />
    </div>

    <a class="tile tile--accent contact-cv-tile contact-order-cv"
       href="/files/CV_TR.pdf"
       download="OmerFarukTuregun_CV_TR.pdf">
        <i class="bi bi-download contact-cv__icon" aria-hidden="true"></i>
        <span class="contact-cv__title">CV indir</span>
        <span class="contact-cv__meta">PDF · Türkçe</span>
    </a>

    <div class="tile tile--static span-2 contact-social-tile contact-order-social">
        <p class="eyebrow">Sosyal</p>
        <h3>Bağlantılar</h3>
        <ul class="link-list contact-social-list">
            <li>
                <a href="https://www.linkedin.com/in/%C3%B6mer-faruk-t%C3%BCreg%C3%BCn-6360532b6/" target="_blank" rel="noopener">
                    <span>LinkedIn</span>
                    <span class="contact-social__handle">/in/ömer-faruk-türegün ↗</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/OmerTuregun" target="_blank" rel="noopener">
                    <span>GitHub</span>
                    <span class="contact-social__handle">@@OmerTuregun ↗</span>
                </a>
            </li>
            <li>
                <a href="https://medium.com/@@trkuraf" target="_blank" rel="noopener">
                    <span>Medium</span>
                    <span class="contact-social__handle">@@trkuraf ↗</span>
                </a>
            </li>
            <li>
                <a href="https://www.instagram.com/omerfarukturegun" target="_blank" rel="noopener">
                    <span>Instagram</span>
                    <span class="contact-social__handle">@@omerfarukturegun ↗</span>
                </a>
            </li>
            <li>
                <a href="https://x.com/o_farukturegun" target="_blank" rel="noopener">
                    <span>X</span>
                    <span class="contact-social__handle">@@o_farukturegun ↗</span>
                </a>
            </li>
        </ul>
    </div>
</section>

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded",function(){Bento.contact.init();});</script>
}
