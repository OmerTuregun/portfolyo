@{
    var lang = ViewContext.RouteData.Values["lang"]?.ToString()?.ToLower() ?? "tr";
    if (lang != "tr" && lang != "en") { lang = "tr"; }
    var isTr = lang == "tr";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var defaultDescription = isTr
        ? "Ömer Faruk Türegün — yazılım mühendisi. Projeler, deneyim ve iletişim."
        : "Ömer Faruk Türegün — software engineer. Projects, experience, and contact.";
    var description = ViewData["Description"] as string ?? defaultDescription;
    var title = ViewData["Title"] as string ?? (isTr ? "Portfolyo" : "Portfolio");
    var skipLabel = isTr ? "İçeriğe geç" : "Skip to content";

    var request = Context.Request;
    var path = $"{request.PathBase}{request.Path}".TrimEnd('/');
    if (string.IsNullOrEmpty(path)) { path = "/"; }
    var canonicalPath = path;
    var siteOrigin = "https://omerfarukturegun.com.tr";
    var canonicalUrl = siteOrigin + (canonicalPath == "/" ? "" : canonicalPath);
    var ogImage = siteOrigin + "/img/profil.jpg";
    var ogLocale = isTr ? "tr_TR" : "en_US";

    string AltUrl(string forLang) =>
        siteOrigin + "/" + forLang + "/" + controller + "/" + action;

    var isHomeIndex = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
                      && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title · Ömer Faruk Türegün</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#eef0f3" />

    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="tr" href="@AltUrl("tr")" />
    <link rel="alternate" hreflang="en" href="@AltUrl("en")" />
    <link rel="alternate" hreflang="x-default" href="@AltUrl("tr")" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ömer Faruk Türegün" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="@ogLocale" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bento.css" asp-append-version="true" />

    @if (isHomeIndex)
    {
        var jobTitle = isTr ? "Yazılım Geliştirici" : "Software Developer";
        <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Person",
          "name": "Ömer Faruk Türegün",
          "url": "@siteOrigin",
          "image": "@ogImage",
          "jobTitle": "@jobTitle",
          "alumniOf": {
            "@@type": "CollegeOrUniversity",
            "name": "Kocaeli Üniversitesi"
          },
          "sameAs": [
            "https://www.linkedin.com/in/%C3%B6mer-faruk-t%C3%BCreg%C3%BCn-6360532b6/",
            "https://github.com/OmerTuregun",
            "https://medium.com/@@trkuraf",
            "https://www.instagram.com/omerfarukturegun",
            "https://x.com/o_farukturegun"
          ]
        }
        </script>
    }

    @RenderSection("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@skipLabel</a>

    <div class="container-d">
        <partial name="_BentoHeader" />
        <main id="main">
            @RenderBody()
        </main>
        <partial name="_BentoFooter" />
    </div>

    <script src="~/js/bento.js" asp-append-version="true" defer></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
