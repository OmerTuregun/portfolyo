@model ErrorViewModel
@{
    Layout = "_LayoutBento";
    var isEn = ViewData["IsEn"] as bool? == true
               || string.Equals(ViewContext.RouteData.Values["lang"]?.ToString(), "en", StringComparison.OrdinalIgnoreCase);
    var lang = isEn ? "en" : "tr";
    ViewData["Title"] = isEn ? "Error" : "Hata";
}

<section class="status-page tile tile--static" aria-labelledby="error-heading">
    <p class="status-page__code" aria-hidden="true">500</p>
    <h1 id="error-heading">@(isEn ? "Something went wrong" : "Bir şeyler ters gitti")</h1>
    <p class="lead">
        @(isEn
            ? "An unexpected error occurred while processing your request."
            : "İsteğiniz işlenirken beklenmeyen bir hata oluştu.")
    </p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="status-page__meta">
            <span class="eyebrow">Request ID</span>
            <code>@Model.RequestId</code>
        </p>
    }
    <div class="btn-row">
        <a class="btn btn--primary" asp-controller="Home" asp-action="Index" asp-route-lang="@lang">
            @(isEn ? "Back to home" : "Ana sayfaya dön")
        </a>
        <a class="btn btn--secondary" asp-controller="Home" asp-action="Contact" asp-route-lang="@lang">
            @(isEn ? "Contact" : "İletişim")
        </a>
    </div>
</section>
