@{
    Layout = null;
    var username = Context.Session.GetString("AdminUsername") ?? "Admin";
    var routeLang = ViewContext.RouteData.Values["lang"]?.ToString() ?? "tr";
    var currentLang = Context.Request.Query["contentLang"].ToString().ToLower();
    if (string.IsNullOrEmpty(currentLang))
    {
        currentLang = Context.Request.Query["lang"].ToString().ToLower();
    }
    if (string.IsNullOrEmpty(currentLang) || (currentLang != "tr" && currentLang != "en"))
    {
        currentLang = ViewData["CurrentLang"]?.ToString()?.ToLower() ?? "tr";
    }
    if (currentLang != "tr" && currentLang != "en") currentLang = "tr";
    var isTr = currentLang == "tr";
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var typeQuery = Context.Request.Query["type"].ToString();
    var isLanguagesMenu = controllerName == "AdminExperience" && typeQuery == "Diller";
    var isExperienceMenu = controllerName == "AdminExperience" && typeQuery != "Diller";
    var flashOk = TempData["Success"]?.ToString();
    var flashErr = TempData["Error"]?.ToString();
    var sectionLabel = controllerName switch
    {
        "Admin" => isTr ? "Kontrol paneli" : "Dashboard",
        "AdminProjects" => isTr ? "Projeler" : "Projects",
        "AdminExperience" => isLanguagesMenu ? (isTr ? "Diller" : "Languages") : (isTr ? "Deneyimler" : "Experiences"),
        "AdminCertificates" => isTr ? "Sertifikalar" : "Certificates",
        "AdminReferences" => isTr ? "Referanslar" : "References",
        "AdminAbout" => isTr ? "Hakkımda" : "About",
        _ => isTr ? "Yönetim" : "Admin"
    };
}

<!DOCTYPE html>
<html lang="@(isTr ? "tr" : "en")">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @(isTr ? "Yönetim Paneli" : "Admin Panel")</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bento.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-bento.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="admin-logo">
                <div class="admin-logo__mark">ömerfaruk<span class="admin-logo__dot">.</span></div>
                <span class="admin-logo__badge">admin</span>
            </div>

            <ul class="admin-menu">
                <li>
                    <a asp-controller="Admin" asp-action="Dashboard" asp-route-lang="@routeLang"
                       class="@(controllerName == "Admin" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-speedometer2"></i></span>
                        <span>@(isTr ? "Kontrol Paneli" : "Dashboard")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminProjects" asp-action="Index" asp-route-lang="@routeLang" asp-route-contentLang="@currentLang"
                       class="@(controllerName == "AdminProjects" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-folder"></i></span>
                        <span>@(isTr ? "Projeler" : "Projects")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@routeLang" asp-route-contentLang="@currentLang"
                       class="@(isExperienceMenu ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-briefcase"></i></span>
                        <span>@(isTr ? "Deneyimler" : "Experiences")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminCertificates" asp-action="Index" asp-route-lang="@routeLang" asp-route-contentLang="@currentLang"
                       class="@(controllerName == "AdminCertificates" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-award"></i></span>
                        <span>@(isTr ? "Sertifikalar" : "Certificates")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@routeLang" asp-route-contentLang="@currentLang" asp-route-type="Diller"
                       class="@(isLanguagesMenu ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-translate"></i></span>
                        <span>@(isTr ? "Diller" : "Languages")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminReferences" asp-action="Index" asp-route-lang="@routeLang" asp-route-contentLang="@currentLang"
                       class="@(controllerName == "AdminReferences" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-people"></i></span>
                        <span>@(isTr ? "Referanslar" : "References")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminAbout" asp-action="Index" asp-route-lang="@routeLang" asp-route-contentLang="@currentLang"
                       class="@(controllerName == "AdminAbout" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-person-badge"></i></span>
                        <span>@(isTr ? "Hakkımda" : "About")</span>
                    </a>
                </li>
            </ul>

            <div class="admin-sidebar__foot">
                <div class="lang-selector" role="group" aria-label="@(isTr ? "İçerik dili" : "Content language")">
                    <a href="?contentLang=tr" class="lang-btn @(currentLang == "tr" ? "active" : "")">TR</a>
                    <a href="?contentLang=en" class="lang-btn @(currentLang == "en" ? "active" : "")">EN</a>
                </div>
                <a href="/@routeLang" class="admin-view-site" target="_blank" rel="noopener">
                    @(isTr ? "Siteyi görüntüle" : "View site") <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <form method="post" asp-controller="Admin" asp-action="Logout" asp-route-lang="@routeLang" class="admin-logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary-custom">
                        <i class="bi bi-box-arrow-right"></i> @(isTr ? "Çıkış" : "Sign out")
                    </button>
                </form>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <p class="eyebrow admin-topbar__eyebrow">@sectionLabel</p>
                    <h1>@(ViewData["PageTitle"] ?? (isTr ? "Yönetim Paneli" : "Admin Panel"))</h1>
                    <p class="admin-topbar__welcome">@(isTr ? "Hoş geldiniz" : "Welcome"), @username</p>
                </div>
            </header>

            <main class="admin-content">
                @if (!string.IsNullOrEmpty(flashOk))
                {
                    <div class="admin-flash admin-flash--ok" role="status">
                        <div>@flashOk</div>
                        <button type="button" class="admin-flash__close" data-admin-flash-close aria-label="@(isTr ? "Kapat" : "Close")">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(flashErr))
                {
                    <div class="admin-flash admin-flash--err" role="status">
                        <div>@flashErr</div>
                        <button type="button" class="admin-flash__close" data-admin-flash-close aria-label="@(isTr ? "Kapat" : "Close")">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/bento.js" asp-append-version="true"></script>
    <script>
        (function () {
            var confirmLabel = @(isTr ? "\"Sil\"" : "\"Delete\"");
            document.querySelectorAll('form[data-confirm]').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (form.getAttribute('data-confirmed') === '1') {
                        form.removeAttribute('data-confirmed');
                        return;
                    }
                    e.preventDefault();
                    var msg = form.getAttribute('data-confirm') || '';
                    var label = form.getAttribute('data-confirm-label') || confirmLabel;
                    if (!window.Bento || typeof window.Bento.confirm !== 'function') {
                        if (window.confirm(msg)) {
                            form.setAttribute('data-confirmed', '1');
                            HTMLFormElement.prototype.submit.call(form);
                        }
                        return;
                    }
                    window.Bento.confirm(msg, { danger: true, confirmLabel: label }).then(function (ok) {
                        if (!ok) return;
                        form.setAttribute('data-confirmed', '1');
                        HTMLFormElement.prototype.submit.call(form);
                    });
                });
            });

            document.querySelectorAll('[data-admin-flash-close]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var flash = btn.closest('.admin-flash');
                    if (flash) flash.remove();
                });
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
