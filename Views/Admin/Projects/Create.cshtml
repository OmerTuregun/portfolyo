@model My_Portfolyo.Models.Admin.ProjectViewModel
@{
    Layout = "_AdminLayout";
    var lang = ViewData["Lang"]?.ToString() ?? "tr";
    var currentLang = ViewData["CurrentLang"]?.ToString() ?? "tr";
    ViewData["Title"] = "Yeni Proje";
    ViewData["PageTitle"] = $"Yeni Proje Ekle ({(currentLang == "tr" ? "TR" : "EN")})";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div></div>
    <a asp-controller="AdminProjects" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" class="btn btn-secondary-custom">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="form-card">
    <form method="post" asp-action="Create" asp-route-lang="@lang" asp-route-contentLang="@currentLang">
        @Html.AntiForgeryToken()
        <input type="hidden" name="contentLang" value="@currentLang" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="DateRange" class="form-label"><i class="bi bi-calendar"></i> Tarih Aralığı *</label>
                <input asp-for="DateRange" class="form-control" placeholder="Örn: 01.2025 - 06.2025" />
                <span asp-validation-for="DateRange" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ImageUrl" class="form-label"><i class="bi bi-image"></i> Görsel URL</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="~/img/... veya https://..." />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"><i class="bi bi-type"></i> Başlık *</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"><i class="bi bi-text-paragraph"></i> Açıklama *</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GithubUrl" class="form-label"><i class="bi bi-github"></i> GitHub URL</label>
            <input asp-for="GithubUrl" class="form-control" type="url" />
            <span asp-validation-for="GithubUrl" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TagsInput" class="form-label"><i class="bi bi-tags"></i> Etiketler</label>
            <input asp-for="TagsInput" class="form-control" placeholder="AI, Python, Docker" />
            <div class="help-text">Virgülle ayırın</div>
        </div>

        <div class="mb-3">
            <label for="ModalContent" class="form-label"><i class="bi bi-file-text"></i> Modal İçeriği (HTML)</label>
            <textarea name="ModalContent" id="ModalContent" class="form-control" rows="10" placeholder="Her satır ayrı kayıt"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary-custom"><i class="bi bi-check-circle"></i> Kaydet</button>
            <a asp-controller="AdminProjects" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" class="btn btn-secondary-custom">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
