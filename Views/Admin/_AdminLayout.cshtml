@{
    Layout = null;
    var username = Context.Session.GetString("AdminUsername") ?? "Admin";
    var currentLang = Context.Request.Query["lang"].ToString().ToLower();
    if (string.IsNullOrEmpty(currentLang) || (currentLang != "tr" && currentLang != "en"))
    {
        currentLang = "tr";
    }
    var isTr = currentLang == "tr";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @(isTr ? "Yönetim Paneli" : "Admin Panel")</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-light: #90EE90;
            --bg-dark: #0D1117;
            --glass-bg: rgba(22, 27, 34, 0.6);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            color: #E6EDF3;
            min-height: 100vh;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 260px;
            background: #05070b;
            border-right: 1px solid var(--glass-border);
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .admin-logo-icon {
            width: 36px;
            height: 36px;
            border-radius: 0.75rem;
            background: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--bg-dark);
        }

        .admin-logo-text {
            font-weight: 800;
            font-size: 1.1rem;
        }

        .admin-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .admin-menu a {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem 0.85rem;
            border-radius: 0.6rem;
            color: #E6EDF3;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .admin-menu a:hover {
            background: rgba(255, 255, 255, 0.06);
            color: var(--primary-light);
        }

        .admin-menu a.active {
            background: rgba(144, 238, 144, 0.16);
            color: var(--primary-light);
        }

        .admin-menu-icon {
            width: 22px;
            text-align: center;
        }

        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .admin-topbar {
            padding: 1rem 2rem;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(5, 7, 11, 0.85);
            backdrop-filter: blur(10px);
        }

        .admin-topbar h1 {
            font-size: 1.4rem;
            margin: 0;
        }

        .admin-topbar-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .admin-lang-group .btn {
            border-color: var(--glass-border);
        }

        .admin-content {
            padding: 2rem;
        }

        /* Dashboard cards / list cards ortak stiller */
        .stat-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 1rem;
            padding: 1.5rem;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            height: 100%;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-light);
            box-shadow: 0 8px 24px rgba(144, 238, 144, 0.2);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            background: var(--primary-light);
            color: var(--bg-dark);
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 900;
            color: var(--primary-light);
            margin: 0.5rem 0;
        }

        .stat-label {
            color: #E6EDF3;
            opacity: 0.7;
            font-size: 0.9rem;
        }

        .action-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 1rem;
            padding: 2rem;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            text-decoration: none;
            color: inherit;
            display: block;
            height: 100%;
        }

        .action-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-light);
            box-shadow: 0 8px 24px rgba(144, 238, 144, 0.2);
            color: inherit;
        }

        .action-icon {
            font-size: 3rem;
            color: var(--primary-light);
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="admin-logo">
                <div class="admin-logo-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div class="admin-logo-text">@(isTr ? "Yönetim Paneli" : "Admin Panel")</div>
            </div>

            <ul class="admin-menu">
                <li>
                    <a asp-controller="Admin" asp-action="Dashboard" asp-route-lang="tr" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-speedometer2"></i></span>
                        <span>@(isTr ? "Kontrol Paneli" : "Dashboard")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminProjects" asp-action="Index" asp-route-lang="tr" asp-route-contentLang="@currentLang" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminProjects" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-folder"></i></span>
                        <span>@(isTr ? "Projeler" : "Projects")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="tr" asp-route-contentLang="@currentLang" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminExperience" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-briefcase"></i></span>
                        <span>@(isTr ? "Deneyimler" : "Experiences")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminCertificates" asp-action="Index" asp-route-lang="tr" asp-route-contentLang="@currentLang" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCertificates" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-award"></i></span>
                        <span>@(isTr ? "Sertifikalar" : "Certificates")</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminLanguages" asp-action="Index" asp-route-lang="tr" asp-route-contentLang="@currentLang" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminLanguages" ? "active" : "")">
                        <span class="admin-menu-icon"><i class="bi bi-translate"></i></span>
                        <span>@(isTr ? "Diller" : "Languages")</span>
                    </a>
                </li>
            </ul>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <h1>@(ViewData["PageTitle"] ?? (isTr ? "Yönetim Paneli" : "Admin Panel"))</h1>
                    <small style="opacity: 0.7;">@(isTr ? "Hoş geldiniz" : "Welcome"), @username</small>
                </div>
                <div class="admin-topbar-right">
                    <div class="btn-group admin-lang-group" role="group">
                        <a href="?lang=tr" class="btn @(currentLang == "tr" ? "btn-primary" : "btn-outline-secondary")"
                           style="background: @(currentLang == "tr" ? "var(--primary-light)" : "transparent"); color: @(currentLang == "tr" ? "var(--bg-dark)" : "#E6EDF3");">
                            TR
                        </a>
                        <a href="?lang=en" class="btn @(currentLang == "en" ? "btn-primary" : "btn-outline-secondary")"
                           style="background: @(currentLang == "en" ? "var(--primary-light)" : "transparent"); color: @(currentLang == "en" ? "var(--bg-dark)" : "#E6EDF3");">
                            EN
                        </a>
                    </div>
                    <form method="post" asp-controller="Admin" asp-action="Logout" asp-route-lang="tr" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm" style="background: rgba(255, 107, 107, 0.1); border: 1px solid rgba(255, 107, 107, 0.3); color: #ff6b6b;">
                            <i class="bi bi-box-arrow-right"></i> @(isTr ? "Çıkış" : "Sign out")
                        </button>
                    </form>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

