@{
    var currentLang = Context.Request.Query["lang"].ToString().ToLower();
    if (string.IsNullOrEmpty(currentLang) || (currentLang != "tr" && currentLang != "en"))
    {
        currentLang = "tr";
    }
    var isTr = currentLang == "tr";

    Layout = "_AdminLayout";
    ViewData["Title"] = isTr ? "Yönetim Paneli" : "Dashboard";
    ViewData["PageTitle"] = isTr ? "Yönetim Paneli" : "Dashboard";
}

<div class="admin-content-inner">
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-folder"></i>
                </div>
                <div class="stat-number" id="projectCount">-</div>
                <div class="stat-label">@(isTr ? "Projeler" : "Projects")</div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-briefcase"></i>
                </div>
                <div class="stat-number" id="experienceCount">-</div>
                <div class="stat-label">@(isTr ? "Deneyimler" : "Experiences")</div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-award"></i>
                </div>
                <div class="stat-number" id="certificateCount">-</div>
                <div class="stat-label">@(isTr ? "Sertifikalar" : "Certificates")</div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-globe"></i>
                </div>
                <div class="stat-number">2</div>
                <div class="stat-label">@(isTr ? "Diller (TR/EN)" : "Languages (TR/EN)")</div>
            </div>
        </div>
    </div>
</div>

<script>
    // İstatistikleri yükle (ileride API ile)
    // Şimdilik placeholder
    document.getElementById('projectCount').textContent = '8';
    document.getElementById('experienceCount').textContent = '4';
    document.getElementById('certificateCount').textContent = '10';
</script>
