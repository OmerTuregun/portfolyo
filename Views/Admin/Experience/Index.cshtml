@model List<My_Portfolyo.Models.Admin.ExperienceSectionViewModel>
@{
    Layout = "_AdminLayout";
    var lang = ViewData["Lang"]?.ToString() ?? "tr";
    var currentLang = ViewData["CurrentLang"]?.ToString() ?? "tr";
    var selectedType = ViewData["SelectedType"]?.ToString();
    var isTr = currentLang == "tr";
    ViewData["Title"] = isTr ? "Deneyimler" : "Experiences";
    ViewData["PageTitle"] = isTr ? "Deneyimler Yönetimi" : "Experiences Management";
}

<div class="admin-page-toolbar">
    <div class="lang-selector">
        <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="tr" asp-route-type="@selectedType" class="lang-btn @(currentLang == "tr" ? "active" : "")">
            <i class="bi bi-translate"></i> @(isTr ? "Türkçe" : "Turkish")
        </a>
        <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="en" asp-route-type="@selectedType" class="lang-btn @(currentLang == "en" ? "active" : "")">
            <i class="bi bi-translate"></i> @(isTr ? "İngilizce" : "English")
        </a>
    </div>
    <a asp-controller="AdminExperience"
       asp-action="Create"
       asp-route-lang="@lang"
       asp-route-contentLang="@currentLang"
       asp-route-type="@selectedType"
       class="btn btn-primary-custom">
        <i class="bi bi-plus-circle"></i> @(isTr ? "Yeni Deneyim Ekle" : "Add New Experience")
    </a>
</div>

<div class="type-filter">
    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="" class="type-btn @(string.IsNullOrEmpty(selectedType) ? "active" : "")">@(isTr ? "Tümü" : "All")</a>
    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="Eğitim" class="type-btn @(selectedType == "Eğitim" ? "active" : "")">@(isTr ? "Eğitim" : "Education")</a>
    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="İş Deneyimi" class="type-btn @(selectedType == "İş Deneyimi" ? "active" : "")">@(isTr ? "İş Deneyimi" : "Work Experience")</a>
    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="Stajlar" class="type-btn @(selectedType == "Stajlar" ? "active" : "")">@(isTr ? "Stajlar" : "Internships")</a>
    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="Diller" class="type-btn @(selectedType == "Diller" ? "active" : "")">@(isTr ? "Diller" : "Languages")</a>
</div>

@if (Model != null && Model.Any())
{
    @foreach (var section in Model)
    {
        @if (selectedType != null && section.Type != selectedType)
        {
            continue;
        }

        var items = new List<My_Portfolyo.Models.Admin.ExperienceViewModel>();
        if (section.Items != null) items.AddRange(section.Items);
        if (section.Experience != null) items.AddRange(section.Experience);

        @if (items.Any())
        {
            var isEducation = section.Type == "Eğitim";
            var isLanguages = section.Type == "Diller";

            <div class="section-card tile--static">
                <div class="section-header">
                    <h4 class="section-title">
                        <i class="bi bi-@(section.Type == "Eğitim" ? "book" : section.Type == "İş Deneyimi" ? "briefcase" : section.Type == "Stajlar" ? "briefcase-fill" : "globe")"></i>
                        @(isTr ? section.Type : (section.Type == "Eğitim" ? "Education" : section.Type == "İş Deneyimi" ? "Work Experience" : section.Type == "Stajlar" ? "Internships" : section.Type == "Diller" ? "Languages" : section.Type))
                    </h4>
                    <a asp-controller="AdminExperience"
                       asp-action="Create"
                       asp-route-lang="@lang"
                       asp-route-contentLang="@currentLang"
                       asp-route-type="@(section.Type)"
                       class="btn btn-sm btn-primary-custom">
                        <i class="bi bi-plus-circle"></i> @(isTr ? "Yeni Ekle" : "Add New")
                    </a>
                </div>

                <div class="table-card">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>@(isTr ? "Başlık" : "Title")</th>
                                @if (!isLanguages)
                                {
                                    <th>@(isTr ? "Şirket/Kurum" : "Company/Institution")</th>
                                    <th>@(isTr ? "Tarih Aralığı" : "Date Range")</th>
                                }
                                @if (!isEducation)
                                {
                                    <th>@(isLanguages ? (isTr ? "Seviye" : "Level") : (isTr ? "Etiketler" : "Tags"))</th>
                                }
                                <th>@(isTr ? "İşlemler" : "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Title</td>
                                    @if (!isLanguages)
                                    {
                                        <td>@item.Company</td>
                                        <td>@item.DateRange</td>
                                    }
                                    @if (!isEducation)
                                    {
                                        <td>
                                            @if (item.Tags != null && item.Tags.Any())
                                            {
                                                @foreach (var tag in item.Tags.Take(3))
                                                {
                                                    <span class="badge badge-outline">@tag</span>
                                                }
                                                @if (item.Tags.Count > 3)
                                                {
                                                    <span class="admin-muted">+@(item.Tags.Count - 3)</span>
                                                }
                                            }
                                            @if (item.Percentage.HasValue)
                                            {
                                                <span class="badge badge-outline">@item.Percentage%</span>
                                            }
                                        </td>
                                    }
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-controller="AdminExperience"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               asp-route-lang="@lang"
                                               asp-route-contentLang="@currentLang"
                                               asp-route-type="@(section.Type)"
                                               class="btn btn-sm btn-secondary-custom">
                                                <i class="bi bi-pencil"></i> @(isTr ? "Düzenle" : "Edit")
                                            </a>
                                            <form method="post"
                                                  asp-controller="AdminExperience"
                                                  asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  asp-route-lang="@lang"
                                                  asp-route-contentLang="@currentLang"
                                                  asp-route-type="@(section.Type)"
                                                  class="d-inline-form"
                                                  data-confirm="@(isTr ? "Bu deneyimi silmek istediğinize emin misiniz?" : "Are you sure you want to delete this experience?")">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger-custom">
                                                    <i class="bi bi-trash"></i> @(isTr ? "Sil" : "Delete")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
else
{
    <div class="section-card tile--static admin-empty">
        <div class="admin-empty__icon"><i class="bi bi-inbox"></i></div>
        <p class="mt-3 mb-0">@(isTr ? "Henüz deneyim eklenmemiş." : "No experiences added yet.")</p>
        <a asp-controller="AdminExperience"
           asp-action="Create"
           asp-route-lang="@lang"
           asp-route-contentLang="@currentLang"
           asp-route-type="@selectedType"
           class="btn btn-primary-custom mt-3">
            <i class="bi bi-plus-circle"></i> @(isTr ? "İlk Deneyimi Ekle" : "Add First Experience")
        </a>
    </div>
}
