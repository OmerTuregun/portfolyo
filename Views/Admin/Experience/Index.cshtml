@model List<My_Portfolyo.Models.Admin.ExperienceSectionViewModel>
@{
    Layout = null;
    var lang = ViewData["Lang"]?.ToString() ?? "tr";
    var currentLang = ViewData["CurrentLang"]?.ToString() ?? "tr";
    var selectedType = ViewData["SelectedType"]?.ToString();
    var username = Context.Session.GetString("AdminUsername") ?? "Admin";
    var isTr = currentLang == "tr";
}

<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(isTr ? "Deneyimler Yönetimi" : "Experiences Management") - Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-light: #90EE90;
            --bg-dark: #0D1117;
            --glass-bg: rgba(22, 27, 34, 0.6);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            color: #E6EDF3;
            min-height: 100vh;
        }

        .admin-navbar {
            background: var(--glass-bg);
            border-bottom: 1px solid var(--glass-border);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            margin-bottom: 2rem;
        }

        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem 2rem;
        }

    .section-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 1rem;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
        margin-bottom: 1.5rem;
    }

    .section-card .table {
        width: auto;
        max-width: 100%;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--glass-border);
    }

    .section-title {
        color: var(--primary-light);
        font-weight: 700;
        font-size: 1.25rem;
        margin: 0;
    }

    .table {
        color: #E6EDF3;
        background-color: transparent !important;
    }

    .table th,
    .table td {
        background-color: transparent !important;
        color: #ffffff;
    }

    .table thead th {
        border-bottom: 2px solid var(--glass-border);
        color: var(--primary-light);
        font-weight: 700;
    }

    .table tbody td {
        font-weight: 600;
    }

    .table tbody tr {
        border-bottom: 1px solid var(--glass-border);
    }

    .table tbody tr:hover {
        background: rgba(144, 238, 144, 0.08);
    }

    .lang-selector {
        display: inline-flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .lang-btn {
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .lang-btn.active {
        background: var(--primary-light);
        color: var(--bg-dark);
    }

    .lang-btn:not(.active) {
        background: rgba(255, 255, 255, 0.1);
        color: #E6EDF3;
    }

    .type-filter {
        margin-bottom: 1.5rem;
    }

    .type-btn {
        padding: 0.5rem 1rem;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .type-btn.active {
        background: var(--primary-light);
        color: var(--bg-dark);
    }

    .type-btn:not(.active) {
        background: rgba(255, 255, 255, 0.1);
        color: #E6EDF3;
    }

    .btn-primary-custom {
        background: var(--primary-light);
        color: var(--bg-dark);
        border: none;
        font-weight: 700;
        padding: 0.5rem 1.5rem;
        border-radius: 0.5rem;
    }

    .btn-primary-custom:hover {
        background: #7dd87d;
        color: var(--bg-dark);
    }

    .btn-danger-custom {
        background: rgba(255, 107, 107, 0.2);
        color: #ff6b6b;
        border: 1px solid rgba(255, 107, 107, 0.3);
    }

    .btn-danger-custom:hover {
        background: rgba(255, 107, 107, 0.3);
        color: #ff6b6b;
    }

    .btn-secondary-custom {
        background: rgba(255, 255, 255, 0.1);
        color: #E6EDF3;
        border: 1px solid var(--glass-border);
    }

    .btn-secondary-custom:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #E6EDF3;
    }
    </style>
</head>
<body>
    <nav class="admin-navbar">
        <div class="admin-container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0" style="color: var(--primary-light);">
                        <i class="bi bi-briefcase-fill"></i> @(isTr ? "Deneyimler Yönetimi" : "Experiences Management")
                    </h3>
                    <small style="opacity: 0.7;">@(isTr ? "Hoş geldiniz" : "Welcome"), @username</small>
                </div>
                <div>
                    <a href="/@lang/Admin/Dashboard" class="btn btn-secondary-custom me-2">
                        <i class="bi bi-arrow-left"></i> @(isTr ? "Dashboard" : "Dashboard")
                    </a>
                    <form method="post" asp-action="Logout" asp-controller="Admin" asp-route-lang="@lang" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn" style="background: rgba(255, 107, 107, 0.1); border: 1px solid rgba(255, 107, 107, 0.3); color: #ff6b6b;">
                            <i class="bi bi-box-arrow-right"></i> @(isTr ? "Çıkış" : "Logout")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <div class="admin-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="lang-selector">
                    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="tr" asp-route-type="@selectedType" class="lang-btn @(currentLang == "tr" ? "active" : "")">
                        <i class="bi bi-translate"></i> @(isTr ? "Türkçe" : "Turkish")
                    </a>
                    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="en" asp-route-type="@selectedType" class="lang-btn @(currentLang == "en" ? "active" : "")">
                        <i class="bi bi-translate"></i> @(isTr ? "İngilizce" : "English")
                    </a>
                </div>
            </div>
            <a asp-controller="AdminExperience"
               asp-action="Create"
               asp-route-lang="@lang"
               asp-route-contentLang="@currentLang"
               asp-route-type="@selectedType"
               class="btn btn-primary-custom">
                <i class="bi bi-plus-circle"></i> @(isTr ? "Yeni Deneyim Ekle" : "Add New Experience")
            </a>
        </div>

        <div class="type-filter">
            <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="" class="type-btn @(string.IsNullOrEmpty(selectedType) ? "active" : "")">@(isTr ? "Tümü" : "All")</a>
            <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="Eğitim" class="type-btn @(selectedType == "Eğitim" ? "active" : "")">@(isTr ? "Eğitim" : "Education")</a>
            <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="İş Deneyimi" class="type-btn @(selectedType == "İş Deneyimi" ? "active" : "")">@(isTr ? "İş Deneyimi" : "Work Experience")</a>
            <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="Stajlar" class="type-btn @(selectedType == "Stajlar" ? "active" : "")">@(isTr ? "Stajlar" : "Internships")</a>
            <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="Diller" class="type-btn @(selectedType == "Diller" ? "active" : "")">@(isTr ? "Diller" : "Languages")</a>
        </div>

        @if (Model != null && Model.Any())
        {
            @foreach (var section in Model)
            {
                @if (selectedType != null && section.Type != selectedType)
                {
                    continue;
                }

                var items = new List<My_Portfolyo.Models.Admin.ExperienceViewModel>();
                if (section.Items != null) items.AddRange(section.Items);
                if (section.Experience != null) items.AddRange(section.Experience);

                @if (items.Any())
                {
                    var isEducation = section.Type == "Eğitim";
                    var isLanguages = section.Type == "Diller";

                    <div class="section-card">
                        <div class="section-header">
                            <h4 class="section-title">
                                <i class="bi bi-@(section.Type == "Eğitim" ? "book" : section.Type == "İş Deneyimi" ? "briefcase" : section.Type == "Stajlar" ? "briefcase-fill" : "globe")"></i>
                                @(isTr ? section.Type : (section.Type == "Eğitim" ? "Education" : section.Type == "İş Deneyimi" ? "Work Experience" : section.Type == "Stajlar" ? "Internships" : section.Type == "Diller" ? "Languages" : section.Type))
                            </h4>
                            <a asp-controller="AdminExperience"
                               asp-action="Create"
                               asp-route-lang="@lang"
                               asp-route-contentLang="@currentLang"
                               asp-route-type="@(section.Type)"
                               class="btn btn-sm btn-primary-custom">
                                <i class="bi bi-plus-circle"></i> @(isTr ? "Yeni Ekle" : "Add New")
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>@(isTr ? "Başlık" : "Title")</th>
                                        @if (!isLanguages)
                                        {
                                            <th>@(isTr ? "Şirket/Kurum" : "Company/Institution")</th>
                                            <th>@(isTr ? "Tarih Aralığı" : "Date Range")</th>
                                        }
                                        @if (!isEducation)
                                        {
                                            <th>@(isLanguages ? (isTr ? "Seviye" : "Level") : (isTr ? "Etiketler" : "Tags"))</th>
                                        }
                                        <th>@(isTr ? "İşlemler" : "Actions")</th>
                                    </tr>
                                </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.Title</td>
                                        @if (!isLanguages)
                                        {
                                            <td>@item.Company</td>
                                            <td>@item.DateRange</td>
                                        }
                                        @if (!isEducation)
                                        {
                                            <td>
                                                @if (item.Tags != null && item.Tags.Any())
                                                {
                                                    @foreach (var tag in item.Tags.Take(3))
                                                    {
                                                        <span class="badge" style="background: transparent; color: #ffffff; border: 1px solid var(--glass-border); margin-right: 0.25rem;">@tag</span>
                                                    }
                                                    @if (item.Tags.Count > 3)
                                                    {
                                                        <span class="text-muted">+@(item.Tags.Count - 3)</span>
                                                    }
                                                }
                                                @if (item.Percentage.HasValue)
                                                {
                                                    <span class="badge" style="background: transparent; color: #ffffff; border: 1px solid var(--glass-border);">@item.Percentage%</span>
                                                }
                                            </td>
                                        }
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-controller="AdminExperience"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   asp-route-lang="@lang"
                                                   asp-route-contentLang="@currentLang"
                                                   asp-route-type="@(section.Type)"
                                                   class="btn btn-sm btn-secondary-custom">
                                                    <i class="bi bi-pencil"></i> @(isTr ? "Düzenle" : "Edit")
                                                </a>
                                                <form method="post"
                                                      asp-controller="AdminExperience"
                                                      asp-action="Delete"
                                                      asp-route-id="@item.Id"
                                                      asp-route-lang="@lang"
                                                      asp-route-contentLang="@currentLang"
                                                      asp-route-type="@(section.Type)"
                                                      style="display: inline;"
                                                      onsubmit="return confirm('@(isTr ? "Bu deneyimi silmek istediğinize emin misiniz?" : "Are you sure you want to delete this experience?")');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger-custom">
                                                        <i class="bi bi-trash"></i> @(isTr ? "Sil" : "Delete")
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="section-card text-center py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; color: var(--primary-light); opacity: 0.5;"></i>
                <p class="mt-3" style="opacity: 0.7;">@(isTr ? "Henüz deneyim eklenmemiş." : "No experiences added yet.")</p>
                <a asp-controller="AdminExperience"
                   asp-action="Create"
                   asp-route-lang="@lang"
                   asp-route-contentLang="@currentLang"
                   asp-route-type="@selectedType"
                   class="btn btn-primary-custom mt-3">
                    <i class="bi bi-plus-circle"></i> @(isTr ? "İlk Deneyimi Ekle" : "Add First Experience")
                </a>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
