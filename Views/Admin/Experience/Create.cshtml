@model My_Portfolyo.Models.Admin.ExperienceViewModel
@{
    Layout = null;
    var lang = ViewData["Lang"]?.ToString() ?? "tr";
    var currentLang = ViewData["CurrentLang"]?.ToString() ?? "tr";
    var type = ViewData["Type"]?.ToString() ?? "Eğitim";
    var types = ViewData["Types"] as List<string> ?? new List<string> { "Eğitim", "İş Deneyimi", "Stajlar", "Diller" };
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yeni Deneyim Ekle - Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-light: #90EE90;
            --bg-dark: #0D1117;
            --glass-bg: rgba(22, 27, 34, 0.6);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            color: #E6EDF3;
            min-height: 100vh;
            padding: 2rem 0;
        }

        .form-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 1rem;
            padding: 2rem;
            backdrop-filter: blur(10px);
            max-width: 900px;
            margin: 0 auto;
        }

        .form-label {
            color: #E6EDF3;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select, textarea.form-control {
            background: rgba(13, 17, 23, 0.8);
            border: 1px solid var(--glass-border);
            color: #E6EDF3;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
        }

        .form-control:focus, .form-select:focus, textarea.form-control:focus {
            background: rgba(13, 17, 23, 0.9);
            border-color: var(--primary-light);
            color: #E6EDF3;
            box-shadow: 0 0 0 0.2rem rgba(144, 238, 144, 0.25);
        }

        .btn-primary-custom {
            background: var(--primary-light);
            color: var(--bg-dark);
            border: none;
            font-weight: 700;
            padding: 0.75rem 2rem;
            border-radius: 0.5rem;
        }

        .btn-primary-custom:hover {
            background: #7dd87d;
            color: var(--bg-dark);
        }

        .btn-secondary-custom {
            background: rgba(255, 255, 255, 0.1);
            color: #E6EDF3;
            border: 1px solid var(--glass-border);
        }

        .text-danger {
            color: #ff6b6b !important;
        }

        .help-text {
            font-size: 0.875rem;
            opacity: 0.7;
            margin-top: 0.25rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            @{
                var isTr = currentLang == "tr";
            }
            <h3 style="color: var(--primary-light);">
                <i class="bi bi-plus-circle"></i> @(isTr ? "Yeni Deneyim Ekle" : "Add New Experience") (@(currentLang == "tr" ? "Türkçe" : "English"))
            </h3>
            <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="@type" class="btn btn-secondary-custom">
                <i class="bi bi-arrow-left"></i> @(isTr ? "Geri Dön" : "Back")
            </a>
        </div>

        <div class="form-card">
            <form method="post" asp-action="Create" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="@type">
                @Html.AntiForgeryToken()
                <input type="hidden" name="contentLang" value="@currentLang" />
                <input type="hidden" name="type" value="@type" />
                
                @{
                    var isTr = currentLang == "tr";
                    var partialName = type switch
                    {
                        "Eğitim" => "_CreateEducation",
                        "İş Deneyimi" => "_CreateWorkExperience",
                        "Stajlar" => "_CreateInternship",
                        "Diller" => "_CreateLanguage",
                        _ => "_CreateEducation"
                    };
                }

                @await Html.PartialAsync($"~/Views/Admin/Experience/{partialName}.cshtml", Model)

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-check-circle"></i> @(isTr ? "Kaydet" : "Save")
                    </button>
                    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="@type" class="btn btn-secondary-custom">
                        <i class="bi bi-x-circle"></i> @(isTr ? "İptal" : "Cancel")
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
