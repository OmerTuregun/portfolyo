@model My_Portfolyo.Models.Admin.ExperienceViewModel
@{
    var lang = ViewData["Lang"]?.ToString() ?? "tr";
    var currentLang = ViewData["CurrentLang"]?.ToString() ?? "tr";
    var isTr = currentLang == "tr";
}

<input type="hidden" name="Type" value="Eğitim" />

<div class="mb-3">
    <label asp-for="Title" class="form-label">
        <i class="bi bi-type"></i> @(isTr ? "Başlık" : "Title") *
    </label>
    <input asp-for="Title" class="form-control" placeholder="@(isTr ? "Örn: Bilgisayar Mühendisliği" : "e.g.: Computer Engineering")" required />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="DateRange" class="form-label">
        <i class="bi bi-calendar"></i> @(isTr ? "Tarih Aralığı" : "Date Range") *
    </label>
    <input asp-for="DateRange" class="form-control" placeholder="@(isTr ? "Örn: 2021 - Devam Ediyor" : "e.g.: 2021 - Ongoing")" required />
    <span asp-validation-for="DateRange" class="text-danger"></span>
    <div class="help-text">@(isTr ? "Örn: 2021 - Devam Ediyor" : "e.g.: 2021 - Ongoing")</div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">
        <i class="bi bi-text-paragraph"></i> @(isTr ? "Açıklama" : "Description") *
    </label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="@(isTr ? "Eğitim açıklaması" : "Education description")" required></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
