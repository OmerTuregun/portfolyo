@model My_Portfolyo.Models.Admin.ExperienceViewModel
@{
    Layout = "_AdminLayout";
    var lang = ViewData["Lang"]?.ToString() ?? "tr";
    var currentLang = ViewData["CurrentLang"]?.ToString() ?? "tr";
    var type = ViewData["Type"]?.ToString() ?? "Eğitim";
    var isTr = currentLang == "tr";
    ViewData["Title"] = isTr ? "Deneyim Düzenle" : "Edit Experience";
    ViewData["PageTitle"] = (isTr ? "Deneyim Düzenle" : "Edit Experience") + " (" + (currentLang == "tr" ? "TR" : "EN") + ")";
}

<div class="admin-page-toolbar">
    <div></div>
    <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="@type" class="btn btn-secondary-custom">
        <i class="bi bi-arrow-left"></i> @(isTr ? "Geri Dön" : "Back")
    </a>
</div>

<div class="form-card tile--static">
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="@type">
        @Html.AntiForgeryToken()
        <input type="hidden" name="contentLang" value="@currentLang" />
        <input type="hidden" name="type" value="@type" />

        @{
            var partialName = type switch
            {
                "Eğitim" => "_EditEducation",
                "İş Deneyimi" => "_EditWorkExperience",
                "Stajlar" => "_EditInternship",
                "Diller" => "_EditLanguage",
                _ => "_EditEducation"
            };
        }

        @await Html.PartialAsync($"~/Views/Admin/Experience/{partialName}.cshtml", Model)

        <div class="form-actions">
            <button type="submit" class="btn btn-primary-custom">
                <i class="bi bi-check-circle"></i> @(isTr ? "Güncelle" : "Update")
            </button>
            <a asp-controller="AdminExperience" asp-action="Index" asp-route-lang="@lang" asp-route-contentLang="@currentLang" asp-route-type="@type" class="btn btn-secondary-custom">
                <i class="bi bi-x-circle"></i> @(isTr ? "İptal" : "Cancel")
            </a>
        </div>
    </form>
</div>
