@model My_Portfolyo.Models.Admin.LoginViewModel
@{
    Layout = null;
    var lang = ViewData["Lang"]?.ToString() ?? "tr";
    var model = Model ?? new My_Portfolyo.Models.Admin.LoginViewModel();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Girişi - Portfolyo</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bento.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-bento.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-container">
        <div class="login-card tile--static">
            <div class="login-header">
                <div class="admin-logo__mark">ömerfaruk<span class="admin-logo__dot">.</span></div>
                <h1>Yönetim paneli</h1>
                <p>Yönetim paneline giriş yapın</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null && ViewData.ModelState[string.Empty].Errors.Count > 0)
            {
                <div class="alert alert-danger" role="status">
                    @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" asp-action="Login" asp-route-lang="@lang">
                @Html.AntiForgeryToken()

                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label for="Username" class="form-label">
                        <i class="bi bi-person"></i> Kullanıcı Adı
                    </label>
                    <input type="text" id="Username" name="Username" class="form-control" placeholder="Kullanıcı adınızı girin" autocomplete="username" value="@(model.Username ?? "")" />
                    @if (ViewData.ModelState["Username"]?.Errors.Count > 0)
                    {
                        <span class="text-danger">@ViewData.ModelState["Username"]?.Errors[0].ErrorMessage</span>
                    }
                </div>

                <div class="mb-3">
                    <label for="Password" class="form-label">
                        <i class="bi bi-lock"></i> Şifre
                    </label>
                    <input type="password" id="Password" name="Password" class="form-control" placeholder="Şifrenizi girin" autocomplete="current-password" />
                    @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                    {
                        <span class="text-danger">@ViewData.ModelState["Password"]?.Errors[0].ErrorMessage</span>
                    }
                </div>

                <button type="submit" class="btn btn-login">
                    <i class="bi bi-box-arrow-in-right"></i> Giriş yap
                </button>
            </form>

            <div class="login-back">
                <a href="/@lang">
                    <i class="bi bi-arrow-left"></i> Ana Sayfaya Dön
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
